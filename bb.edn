{:tasks
 {:init
  (do
    (def container-args
      ["podman" "run" "--rm" "--network" "none"
       "-v" (str (System/getProperty "user.dir") ":/work:ro")
       "--tmpfs" "/tmp:rw,mode=1777" "-w" "/tmp"
       "-e" "HOME=/tmp/test-home" "-e" "PYTHONDONTWRITEBYTECODE=1"])
    (defn isolated [image & args]
      (apply shell (concat container-args [image] args))))

  build:test-image
  {:doc "Build isolated helper test image (Python, Babashka, Emacs/Org, Git)"
   :task (shell "podman" "build" "--layers" "--target" "helpers" "-t" "dotagents-helpers-test"
                "-f" "test/Containerfile" ".")}

  build:callgraph-image
  {:doc "Build analyzer image with checksum-pinned clj-kondo v2026.01.19"
   :task (shell "podman" "build" "--layers" "--target" "analyzer" "-t" "dotagents-callgraph-test"
                "-f" "test/Containerfile" ".")}

  test
  {:doc "Run retained skill, helper/native and pinned Clojure analyzer tests"
   :task (do (run 'test:unit) (run 'test:native) (run 'test:callgraph))}

  test:unit
  {:doc "Run retained todo, Python callgraph and dataflow unit tests in Podman"
   :task (do
           (isolated "localhost/dotagents-helpers-test"
                     "bb" "--config" "/work/skills/add-todo/bb.edn"
                     "--deps-root" "/work/skills/add-todo" "/work/test/unit/runner.clj")
           (isolated "localhost/dotagents-helpers-test" "python3" "-m" "unittest" "discover"
                     "-s" "/work/skills/callgraph/test" "-p" "test_*.py")
           (isolated "localhost/dotagents-helpers-test" "python3" "-m" "unittest" "discover"
                     "-s" "/work/skills/dataflow/test" "-p" "test_*.py"))}

  test:native
  {:doc "Check exact layout/archive bytes and real helpers in a non-Git private HOME"
   :task (isolated "localhost/dotagents-helpers-test" "python3" "/work/test/native_resources_test.py")}

  test:callgraph
  {:doc "Run Clojure analyzer suite; requires separately built pinned analyzer image"
   :task (isolated "localhost/dotagents-callgraph-test" "bb" "--config"
                   "/work/skills/callgraph/bb.edn" "test")}

  test:pi
  {:doc "Native Pi resource loading/filtering, offline; PI_PACKAGE_DIR must name installed Pi package"
   :task (let [pi-dir (System/getenv "PI_PACKAGE_DIR")]
           (when-not pi-dir
             (throw (ex-info "Set PI_PACKAGE_DIR to the installed @earendil-works/pi-coding-agent directory" {})))
           (apply shell
                  (concat container-args
                          ["-v" (str (babashka.fs/canonicalize (babashka.fs/path pi-dir "../..")) ":/pi/node_modules:ro")
                           "-e" "PI_PACKAGE_DIR=/pi/node_modules/@earendil-works/pi-coding-agent"
                           "docker.io/library/node:22"
                           "node" "/work/test/pi_native_test.mjs"])))}

  test:ci
  {:doc "Run read-only suites in an already isolated CI environment with required tools"
   :task (do
           (when-not (System/getenv "CI")
             (throw (ex-info "Use bb test locally; test:ci requires an isolated CI environment" {})))
           (shell "bb" "--config" "skills/add-todo/bb.edn" "--deps-root" "skills/add-todo"
                  "test/unit/runner.clj")
           (shell "python3" "-m" "unittest" "discover" "-s" "skills/callgraph/test" "-p" "test_*.py")
           (shell "python3" "-m" "unittest" "discover" "-s" "skills/dataflow/test" "-p" "test_*.py")
           (shell "python3" "test/native_resources_test.py")
           (shell "bb" "--config" "skills/callgraph/bb.edn" "test")
           (shell "node" "test/pi_native_test.mjs"))}}}
